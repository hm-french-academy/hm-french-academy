  "grammar": {
    "title": "Il y a / Il n'y a pas de",
    "explanationAr": "نستخدم Il y a للتعبير عن وجود شخص أو شيء، وعند النفي نستخدم Il n'y a pas de أو Il n'y a pas d' قبل الاسم.",
    "explanationFr": "On utilise Il y a pour parler de la présence de personnes ou de choses. À la forme négative, on utilise Il n'y a pas de / d'.",
    "steps": [
      "🇪🇬 يوجد / توجد: Il y a + اسم.",
      "🇪🇬 يوجد جمع: Il y a + des + اسم.",
      "🇪🇬 لا يوجد / لا توجد: Il n'y a pas de + اسم.",
      "🇪🇬 قبل حرف متحرك: Il n'y a pas d' + اسم."
    ],
    "examples": [
      {
        "fr": "Il y a un tableau.",
        "ar": "يوجد سبورة."
      },
      {
        "fr": "Il y a des livres.",
        "ar": "توجد كتب."
      },
      {
        "fr": "Il y a un tableau ? Non, il n'y a pas de tableau.",
        "ar": "هل توجد سبورة؟ لا، لا توجد سبورة."
      },
      {
        "fr": "Il y a trois professeurs à l'école.",
        "ar": "يوجد ثلاثة مدرسين في المدرسة."
      }
    ]
  },
  "conversation": {
    "title": "Les professions et la présence",
    "lines": [
      {
        "speaker": "Sara",
        "fr": "Il y a un professeur à l'école ?",
