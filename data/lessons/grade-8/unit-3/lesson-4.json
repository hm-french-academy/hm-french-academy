{"id":"grade8-u3-l4","title":"Prépositions, à ou en, et mots interrogatifs","unit":"Le voyage","language":"fr","contentSource":"curriculum-aligned lesson framework","vocabulary":[{"word":"à","translation":"إلى / في","image":"assets/vocabulary/unit3/a.svg","example":"Je vais à Paris.","pronunciationNote":"تُنطق /a/ بصوت قصير وواضح."},{"word":"en","translation":"بـ / في","image":"assets/vocabulary/unit3/en.svg","example":"Je voyage en avion.","pronunciationNote":"تُنطق /ɑ̃/؛ النهاية صوت أنفي."},{"word":"où","translation":"أين","image":"assets/vocabulary/unit3/ou.svg","example":"Où est la gare ?","pronunciationNote":"تُنطق /u/."},{"word":"quand","translation":"متى","image":"assets/vocabulary/unit3/quand.svg","example":"Quand pars-tu ?","pronunciationNote":"تُنطق /kɑ̃/؛ النهاية صوت أنفي."},{"word":"comment","translation":"كيف","image":"assets/vocabulary/unit3/comment.svg","example":"Comment vas-tu ?","pronunciationNote":"تُنطق /kɔmɑ̃/؛ النهاية أنفية."},{"word":"pourquoi","translation":"لماذا","image":"assets/vocabulary/unit3/pourquoi.svg","example":"Pourquoi voyages-tu ?","pronunciationNote":"تُنطق /puʁkwa/."},{"word":"gare","translation":"محطة القطار","image":"assets/vocabulary/unit3/gare.svg","example":"La gare est près d'ici.","pronunciationNote":"تُنطق /ɡaʁ/؛ r فرنسية في النهاية."},{"word":"avion","translation":"طائرة","image":"assets/vocabulary/unit3/avion.svg","example":"Je voyage en avion.","pronunciationNote":"تُنطق /avjɔ̃/؛ النهاية صوت أنفي."}],"grammar":{"title":"à / en مع الأماكن ووسائل النقل + أدوات السؤال","explanation":"نستخدم à غالبًا مع المدن وبعض الأماكن، ونستخدم en مع وسائل نقل مثل en avion وen train، ونستخدم où وquand وcomment وpourquoi حسب نوع المعلومة المطلوبة.","rules":[{"label":"à + مدينة / مكان","detail":"Je vais à Paris. — أذهب إلى باريس."},{"label":"en + وسيلة نقل","detail":"Je voyage en avion. / Je voyage en train. — أسافر بالطائرة / القطار."},{"label":"où","detail":"للسؤال عن المكان: Où est la gare ?"},{"label":"quand","detail":"للسؤال عن الوقت: Quand pars-tu ?"},{"label":"comment","detail":"للسؤال عن الطريقة: Comment vas-tu à Paris ?"},{"label":"pourquoi","detail":"للسؤال عن السبب: Pourquoi voyages-tu ?"}],"examples":[{"fr":"Je vais à Paris.","ar":"أذهب إلى باريس."},{"fr":"Je voyage en avion.","ar":"أسافر بالطائرة."},{"fr":"Où est la gare ?","ar":"أين محطة القطار؟"},{"fr":"Quand pars-tu ?","ar":"متى ستغادر؟"},{"fr":"Comment vas-tu à Paris ?","ar":"كيف تذهب إلى باريس؟"},{"fr":"Pourquoi voyages-tu ?","ar":"لماذا تسافر؟"}]},"conversation":{"title":"À la gare","lines":[{"speaker":"Sara","fr":"Comment vas-tu à Paris ?","ar":"كيف تذهب إلى باريس؟"},{"speaker":"Adam","fr":"Je voyage en train.","ar":"أسافر بالقطار."},{"speaker":"Sara","fr":"Quand pars-tu ?","ar":"متى ستغادر؟"},{"speaker":"Adam","fr":"Je pars demain.","ar":"سأغادر غدًا."},{"speaker":"Sara","fr":"Où est la gare ?","ar":"أين محطة القطار؟"},{"speaker":"Adam","fr":"La gare est près d'ici.","ar":"المحطة قريبة من هنا."}]},"practice":[{"question":"أكمل: Je vais ___ Paris.","options":["à","en","où"],"answer":0},{"question":"أكمل: Je voyage ___ avion.","options":["en","à","quand"],"answer":0},{"question":"ما أداة السؤال عن المكان؟","options":["où","quand","pourquoi"],"answer":0},{"question":"ما أداة السؤال عن الوقت؟","options":["quand","où","comment"],"answer":0},{"question":"ما أداة السؤال عن الطريقة؟","options":["comment","où","quand"],"answer":0},{"question":"ما أداة السؤال عن السبب؟","options":["pourquoi","comment","où"],"answer":0}],"assessment":{"questions":[{"question":"اختر الجملة الصحيحة.","options":["Je vais à Paris.","Je vais en Paris.","Je à Paris vais."],"answer":0},{"question":"اختر الجملة الصحيحة.","options":["Je voyage en avion.","Je voyage à avion.","Je en avion voyage."],"answer":0},{"question":"اختر أداة السؤال عن المكان: ___ est la gare ?","options":["Où","Quand","Pourquoi"],"answer":0},{"question":"اختر أداة السؤال عن الوقت: ___ pars-tu ?","options":["Quand","Où","Comment"],"answer":0},{"question":"اختر أداة السؤال عن الطريقة: ___ vas-tu à Paris ?","options":["Comment","Pourquoi","Où"],"answer":0},{"question":"اختر أداة السؤال عن السبب: ___ voyages-tu ?","options":["Pourquoi","Quand","Où"],"answer":0},{"question":"أكمل: Nous voyageons ___ train.","options":["en","à","où"],"answer":0},{"question":"أكمل: Je vais ___ la gare.","options":["à","en","quand"],"answer":0}],"status":"standardized"},"media":{"video":"unit3-lesson4-prepositions-questions","audio":true},"resources":{"reference":"data/lessons/grade-8/unit-3/reference-lecon4.html","interactiveAssessment":"data/lessons/grade-8/unit-3/interactive_assessment_lecon4_unite3.html","formalAssessment":"data/lessons/grade-8/unit-3/formal_assessment_lecon4_unite3.html","games":"data/lessons/grade-8/unit-3/lesson-4-games.html"}}