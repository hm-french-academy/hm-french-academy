  "grammar":{
    "title":"Prendre / Aller + lieux",
    "explanation":"نستخدم prendre للتعبير عن وسيلة النقل، ونستخدم aller للتعبير عن الوجهة. بعد ذلك نختار أداة المكان حسب جنس وعدد المكان: à la للمؤنث المفرد، au للمذكر المفرد، à l' قبل حرف متحرك، aux للجمع.",
    "decision_rule":"وسيلة النقل → prendre. الوجهة → aller. ثم حدّد جنس وعدد اسم المكان.",
    "conjugation":{
      "prendre":{"je":"prends","tu":"prends","il/elle":"prend","nous":"prenons","vous":"prenez","ils/elles":"prennent"},
      "aller":{"je":"vais","tu":"vas","il/elle":"va","nous":"allons","vous":"allez","ils/elles":"vont"}
    },
    "examples":[
      {"fr":"Je prends le bus.","ar":"أستقل الحافلة."},
      {"fr":"Nous prenons le train.","ar":"نستقل القطار."},
      {"fr":"Je vais à la gare.","ar":"أذهب إلى محطة القطار."},
      {"fr":"Il va au musée.","ar":"يذهب إلى المتحف."},
      {"fr":"Je vais à l'aéroport.","ar":"أذهب إلى المطار."},
      {"fr":"Nous allons aux stations.","ar":"نذهب إلى المحطات."}
    ]
  },
