{"id":"grade8-u3-l3","title":"Conjugaison et adjectifs démonstratifs","unit":"Le voyage","language":"fr","contentSource":"curriculum-aligned lesson framework","vocabulary":[{"word":"ce","translation":"هذا (مذكر)","image":"👈","example":"Ce train est rapide."},{"word":"cet","translation":"هذا (قبل حرف متحرك)","image":"👉","example":"Cet avion est grand."},{"word":"cette","translation":"هذه","image":"☝️","example":"Cette valise est lourde."},{"word":"ces","translation":"هؤلاء / هذه (جمع)","image":"👥","example":"Ces billets sont importants."},{"word":"rapide","translation":"سريع","image":"⚡","example":"Le train est rapide."},{"word":"lent","translation":"بطيء","image":"🐢","example":"Le bus est lent."}],"grammar":{"explanation":"Employer ce, cet, cette et ces pour désigner des objets et conjuguer les verbes utiles du voyage au présent.","examples":[{"fr":"Ce train est rapide.","ar":"هذا القطار سريع."},{"fr":"Cette valise est lourde.","ar":"هذه الحقيبة ثقيلة."},{"fr":"Ces billets sont importants.","ar":"هذه التذاكر مهمة."}]},"conversation":{"lines":[{"speaker":"Sara","fr":"Quel train prends-tu ?","ar":"أي قطار ستستقل؟"},{"speaker":"Adam","fr":"Ce train-ci.","ar":"هذا القطار."},{"speaker":"Sara","fr":"Et cette valise ?","ar":"وهذه الحقيبة؟"},{"speaker":"Adam","fr":"C'est ma valise.","ar":"هذه حقيبتي."}]},"practice":[{"question":"اختر: ___ train","options":["ce","cette","ces"],"answer":0},{"question":"اختر: ___ avion","options":["cet","ce","cette"],"answer":0},{"question":"اختر: ___ valise","options":["cette","ce","ces"],"answer":0},{"question":"اختر: ___ billets","options":["ces","ce","cet"],"answer":0}],"assessment":{"questions":[{"question":"ما الصيغة الصحيحة مع valise؟","options":["cette valise","ce valise","ces valise"],"answer":0},{"question":"ما الصيغة الصحيحة مع avion؟","options":["cet avion","cette avion","ce avion"],"answer":0}]},"status":"standardized"}
