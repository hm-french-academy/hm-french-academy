{"id":"grade8-u2-l1","title":"Les pièces de la maison et la chambre","unit":"La maison","language":"fr","contentSource":"curriculum-aligned lesson framework + verified source vocabulary shown in the original lesson material","vocabulary":[{"word":"la maison","translation":"المنزل","image":"🏠","example":"Ma maison est grande."},{"word":"la chambre","translation":"غرفة النوم","image":"🛏️","example":"Ma chambre est petite."},{"word":"la porte","translation":"الباب","image":"🚪","example":"La porte est fermée."},{"word":"la fenêtre","translation":"النافذة","image":"🪟","example":"La fenêtre est ouverte."},{"word":"le lit","translation":"السرير","image":"🛏️","example":"Le lit est dans la chambre."},{"word":"l'armoire","translation":"خزانة الملابس","image":"🗄️","example":"L'armoire est dans la chambre."},{"word":"un oreiller","translation":"وسادة","image":"🛌","example":"L'oreiller est sur le lit."},{"word":"un bureau","translation":"مكتب","image":"🖥️","example":"Le bureau est dans la chambre."},{"word":"une chaise","translation":"كرسي","image":"🪑","example":"La chaise est dans la chambre."},{"word":"une table de chevet","translation":"منضدة بجوار السرير","image":"🛏️","example":"La table de chevet est près du lit."},{"word":"un abat-jour","translation":"غطاء المصباح","image":"💡","example":"L'abat-jour est sur la table de chevet."},{"word":"un tapis","translation":"سجادة","image":"🧶","example":"Le tapis est sur le sol."},{"word":"un matelas","translation":"مرتبة","image":"🛏️","example":"Le matelas est sur le lit."},{"word":"un réveil","translation":"منبه","image":"⏰","example":"Le réveil est sur la table de chevet."},{"word":"un tableau","translation":"لوحة","image":"🖼️","example":"Le tableau est sur le mur."},{"word":"un miroir","translation":"مرآة","image":"🪞","example":"Le miroir est dans la chambre."},{"word":"un lustre","translation":"نجفة","image":"💡","example":"Le lustre est au plafond."},{"word":"un rideau","translation":"ستارة","image":"🪟","example":"Le rideau est de