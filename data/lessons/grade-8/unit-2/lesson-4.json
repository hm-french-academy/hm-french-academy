{"id":"grade8-u2-l4","title":"Les prépositions de lieu et les adjectifs possessifs","unit":"La maison","language":"fr","contentSource":"curriculum-aligned lesson framework","vocabulary":[{"word":"sur","translation":"فوق","image":"⬆️","example":"Le livre est sur la table."},{"word":"sous","translation":"تحت","image":"⬇️","example":"Le sac est sous la table."},{"word":"dans","translation":"داخل","image":"📦","example":"Le livre est dans le sac."},{"word":"devant","translation":"أمام","image":"👈","example":"La chaise est devant la table."},{"word":"mon","translation":"ـي (مذكر)","image":"👤","example":"C'est mon livre."},{"word":"ma","translation":"ـي (مؤنث)","image":"👤","example":"C'est ma chambre."}],"grammar":{"explanation":"Utiliser les prépositions de lieu et les adjectifs possessifs mon, ma, mes.","examples":[{"fr":"Le livre est sur la table.","ar":"الكتاب فوق الطاولة."},{"fr":"C'est ma chambre.","ar":"هذه غرفتي."},{"fr":"Ce sont mes livres.","ar":"هذه كتبي."}]},"conversation":{"lines":[{"speaker":"Sara","fr":"Où est ton livre ?","ar":"أين كتابك؟"},{"speaker":"Adam","fr":"Il est sur la table.","ar":"إنه فوق الطاولة."},{"speaker":"Sara","fr":"Et ta chambre ?","ar":"وماذا عن غرفتك؟"},{"speaker":"Adam","fr":"Ma chambre est devant la cuisine.","ar":"غرفتي أمام المطبخ."}]},"practice":[{"question":"أكمل: Le livre est ___ la table.","options":["sur","mes","ma"],"answer":0},{"question":"ما معنى sous؟","options":["تحت","فوق","أمام"],"answer":0},{"question":"اختر الصحيح: ___ chambre","options":["ma","mon","mes"],"answer":0},{"question":"اختر الصحيح: ___ livres","options":["mes","ma","mon"],"answer":0}],"assessment":{"questions":[{"question":"اختر الجملة الصحيحة.","options":["Le sac est sous la table.","Le sac sous est table.","Sous le sac table."],"answer":0},{"question":"اختر الملكية الصحيحة.","options":["ma chambre","mon chambre","mes chambre"],"answer":0}]},"status":"standardized"}
