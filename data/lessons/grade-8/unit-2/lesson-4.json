{"id":"grade8-u2-l4","title":"Les prépositions de lieu et les adjectifs possessifs","unit":"La maison","language":"fr","contentSource":"curriculum-aligned lesson framework","vocabulary":[{"word":"sur","translation":"فوق","image":"⬆️","example":"Le livre est sur la table."},{"word":"sous","translation":"تحت","image":"⬇️","example":"Le sac est sous la table."},{"word":"dans","translation":"داخل","image":"📦","example":"Le livre est dans le sac."},{"word":"devant","translation":"أمام","image":"👈","example":"La chaise est devant la table."},{"word":"derrière","translation":"خلف","image":"↩️","example":"La chaise est derrière la table."},{"word":"entre","translation":"بين","image":"↔️","example":"La table est entre les chaises."},{"word":"mon","translation":"ـي (مذكر)","image":"👤","example":"C'est mon livre."},{"word":"ma","translation":"ـي (مؤنث)","image":"👤","example":"C'est ma chambre."},{"word":"mes","translation":"ـي (جمع)","image":"👤","example":"Ce sont mes livres."},{"word":"ton","translation":"ـك (مذكر)","image":"👤","example":"C'est ton livre."},{"word":"ta","translation":"ـك (مؤنث)","image":"👤","example":"C'est ta chambre."},{"word":"tes","translation":"ـك (جمع)","image":"👤","example":"Ce sont tes livres."},{"word":"son","translation":"ـه / ـها (مذكر)","image":"👤","example":"C'est son livre."},{"word":"sa","translation":"ـه / ـها (مؤنث)","image":"👤","example":"C'est sa chambre."},{"word":"ses","translation":"ـه / ـها (جمع)","image":"👤","example":"Ce sont ses livres."}],"grammar":{"order":["Prépositions de lieu: sur, sous, dans, devant, derrière, entre","Possessifs: mon / ma / mes","Possessifs: ton / ta / tes","Possessifs: son / sa / ses","mon devant un nom féminin commençant par une voyelle"],"explanation":"Utiliser les prépositions de lieu puis les adjectifs possessifs mon, ma, mes, ton, ta, tes, son, sa, ses.","examples":[{"fr":"Le livre est sur la table.","ar":"الكتاب فوق الطاولة."},{"fr":"C'est ma chambre.","ar":"هذه غرفتي."},{"fr":"Ce sont mes livres.","ar":"هذه كتبي."},{"fr":"Mon amie est dans la chambre.","ar":"صديقتي في الغرفة."}]},"conversation":{"lines":[{"speaker":"Sara","fr":"Où est ton livre ?","ar":"أين كتابك؟"},{"speaker":"Adam","fr":"Il est sur la table.","ar":"إنه فوق الطاولة."},{"speaker":"Sara","fr":"Et ta chambre ?","ar":"وماذا عن غرفتك؟"},{"speaker":"Adam","fr":"Ma chambre est devant la cuisine.","ar":"غرفتي أمام المطبخ."}]},"practice":[{"question":"أكمل: Le livre est ___ la table.","options":["sur","mes","ma"],"answer":0},{"question":"ما معنى sous؟","options":["تحت","فوق","أمام"],"answer":0},{"question":"اختر الصحيح: ___ chambre","options":["ma","mon","mes"],"answer":0},{"question":"اختر الصحيح: ___ livres","options":["mes","ma","mon"],"answer":0}],"assessment":{"questions":[{"question":"اختر الجملة الصحيحة.","options":["Le sac est sous la table.","Le sac sous est table.","Sous le sac table."],"answer":0},{"question":"اختر الملكية الصحيحة.","options":["ma chambre","mon chambre","mes chambre"],"answer":0}]},"status":"standardized"}