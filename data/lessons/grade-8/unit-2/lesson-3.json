{"id":"grade8-u2-l3","title":"Vocabulaire général et conjugaison Avoir / Être","unit":"La maison","language":"fr","contentSource":"curriculum-aligned lesson framework","vocabularySource":"original lesson source","vocabulary":[{"word":"un mur","translation":"حائط","image":"🧱","example":"Le mur est blanc."},{"word":"un repas","translation":"وجبة","image":"🍽️","example":"Nous préparons un repas."},{"word":"une maison","translation":"منزل","image":"🏠","example":"C'est une maison."},{"word":"une pièce","translation":"غرفة","image":"🚪","example":"Cette pièce est grande."},{"word":"une boîte","translation":"صندوق","image":"📦","example":"La boîte est sur la table."},{"word":"une voiture","translation":"سيارة","image":"🚗","example":"La voiture est devant la maison."},{"word":"un balcon","translation":"شرفة","image":"🏡","example":"Le balcon est grand."},{"word":"un téléphone","translation":"تليفون","image":"📱","example":"J'ai un téléphone."},{"word":"des meubles","translation":"أثاث","image":"🪑","example":"Il y a des meubles dans la maison."},{"word":"une banque","translation":"بنك","image":"🏦","example":"La banque est près de la maison."},{"word":"un musée","translation":"متحف","image":"🏛️","example":"Nous visitons un musée."},{"word":"une photo","translation":"صورة","image":"📷","example":"J'ai une photo."},{"word":"un bus","translation":"أتوبيس","image":"🚌","example":"Je prends le bus."},{"word":"un parc","translation":"حديقة عامة","image":"🌳","example":"Le parc est près de l'école."},{"word":"une poste","translation":"مكتب بريد","image":"📮","example":"La poste est dans la ville."},{"word":"une gare","translation":"محطة قطار","image":"🚉","example":"La gare est près du parc."},{"word":"un cinéma","translation":"سينما","image":"🎬","example":"Le cinéma est dans la ville."},{"word":"un hôpital","translation":"مستشفى","image":"🏥","example":"L'hôpital est près de la gare."},{"word":"une école","translation":"مدرسة","image":"🏫","example":"L'école est près de la maison."},{"word":"un lycée","translation":"مدرسة ثانوية","image":"🎓","example":"Le lycée est dans la ville."},{"word":"un théâtre","translation":"مسرح","image":"🎭","example":"Le théâtre est près du musée."},{"word":"une clé","translation":"مفتاح","image":"🔑","example":"J'ai une clé."}],"supportingVocabulary":[{"word":"grand","translation":"كبير","image":"📏","example":"Le salon est grand."},{"word":"petit","translation":"صغير","image":"📐","example":"La chambre est petite."},{"word":"propre","translation":"نظيف","image":"✨","example":"La cuisine est propre."},{"word":"beau","translation":"جميل","image":"⭐","example":"C'est une belle maison."},{"word":"une chambre","translation":"غرفة","image":"🛏️","example":"J'ai une chambre."}],"grammar":{"order":["Avoir au présent","Être au présent"],"explanation":"Conjuguer avoir puis être au présent et les utiliser pour décrire la maison.","conjugation":[{"verb":"avoir","title":"Avoir au présent","forms":[["je","ai"],["tu","as"],["il / elle","a"],["nous","avons"],["vous","avez"],["ils / elles","ont"]]},{"verb":"être","title":"Être au présent","forms":[["je","suis"],["tu","es"],["il / elle","est"],["nous","sommes"],["vous","êtes"],["ils / elles","sont"]]}],"examples":[{"fr":"J'ai une chambre.","ar":"لدي غرفة."},{"fr":"Tu es dans le salon.","ar":"أنت في غرفة المعيشة."},{"fr":"Nous avons une maison.","ar":"لدينا منزل."},{"fr":"Ils sont dans la maison.","ar":"هم في المنزل."}]},"conversation":{"lines":[{"speaker":"Sara","fr":"Tu as une grande maison ?","ar":"هل لديك منزل كبير؟"},{"speaker":"Adam","fr":"Oui, j'ai une grande maison.","ar":"نعم، لدي منزل كبير."},{"speaker":"Sara","fr":"Tu es dans ta chambre ?","ar":"هل أنت في غرفتك؟"},{"speaker":"Adam","fr":"Oui, je suis dans ma chambre.","ar":"نعم، أنا في غرفتي."}]},"practice":[{"question":"أكمل: J'___ une chambre.","options":["ai","suis","es"],"answer":0},{"question":"أكمل: Je ___ dans le salon.","options":["suis","ai","as"],"answer":0},{"question":"اختر صيغة avoir الصحيحة مع nous.","options":["avons","avez","ont"],"answer":0},{"question":"اختر صيغة être الصحيحة مع tu.","options":["es","est","suis"],"answer":0},{"question":"اختر صيغة avoir الصحيحة مع ils.","options":["ont","avez","sommes"],"answer":0},{"question":"اختر صيغة être الصحيحة مع vous.","options":["êtes","sont","avez"],"answer":0}],"assessment":{"questions":[{"question":"ما معنى J'ai une chambre؟","options":["لدي غرفة","أنا في الغرفة","أحب الغرفة"],"answer":0},{"question":"اختر الجملة الصحيحة.","options":["Nous avons une maison.","Nous êtes une maison.","Nous ai une maison."],"answer":0},{"question":"اختر الصيغة الصحيحة: Ils ___ dans la maison.","options":["sont","ont","êtes"],"answer":0},{"question":"اختر الصيغة الصحيحة: Vous ___ une maison.","options":["avez","êtes","ont"],"answer":0}],"status":"standardized"}}