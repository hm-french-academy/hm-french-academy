)","translation":"مفضل / مفضلة","category":"adjectifs"},{"word":"désolé(e)","translation":"آسف / آسفة","category":"expressions"},{"word":"moi","translation":"أنا","category":"expressions"},{"word":"toi","translation":"أنت","category":"expressions"},{"word":"J'aime","translation":"أنا أحب","category":"expressions"},{"word":"Je n'aime pas","translation":"أنا لا أحب","category":"expressions"},{"word":"Excuse-moi","translation":"معذرة / اعذرني","category":"expressions"},{"word":"rencontre sur le chat","translation":"مقابلة على الدردشة","category":"expressions"}],"numbers":{"range":"0-50","core":["zéro","un","deux","trois","quatre","cinq","six","sept","huit","neuf","dix","onze","douze","treize","quatorze","quinze","seize","dix-sept","dix-huit","dix-neuf","vingt","vingt et un","vingt-deux","vingt-trois","vingt-quatre","vingt-cinq","vingt-six","vingt-sept","vingt-huit","vingt-neuf","trente","trente et un","trente-deux","trente-trois","trente-quatre","trente-cinq","trente-six","trente-sept","trente-huit","trente-neuf","quarante","quarante et un","quarante-deux","quarante-trois","quarante-quatre","quarante-cinq","quarante-six","quarante-sept","quarante-huit","quarante-neuf","cinquante"],"enrichment":"استخدام الأعداد في العمر والبيانات الشخصية والتدريب على 21 و31 و41 والعدد 50."},"alphabet":{"goal":"التعرف على الحروف الفرنسية وتهجئة الاسم والكلمات البسيطة","practice":"Épelle ton prénom؛ écoute puis choisis la lettre المناسبة؛ أكمل تهجئة اسم.","challenge":"تهجئة الاسم والمدينة ثم مقارنة عدد الحروف."},"colors":["rouge","rose","jaune","beige","violet","bleu","vert","gris","blanc","noir","marron","orange"],"grammar":{"title":"s'appeler + être + avoir (âge)","explanationAr":"s'appeler للتعريف بالاسم، être للتعريف بالشخص، وavoir للتعبير عن العمر.","examples":[{"fr":"Je m'appelle Mathilde.","ar":"اسمي ماتيلد."},{"fr":"Tu t'appelles comment ?","ar":"ما اسمك؟"},{"fr":"Je suis élève.","ar":"أنا تلميذ/تلميذة."},{"fr":"C'est Théo.","ar":"هذا تيو."},{"fr":"J'ai quinze ans.","ar":"عمري خمس