{"id":"s1-u1-01","title":"Les retrouvailles & se présenter","titleAr":"التعارف وتقديم النفس","source":"Club @dos Plus 1 pp.6-9","status":"source-aligned-draft","objectiveAr":"استخدام التحية وتقديم الاسم والعمر والمدينة والتعريف بالآخرين.","vocabulary":[{"word":"Bonjour","translation":"مرحبًا"},{"word":"Salut","translation":"مرحبًا / أهلًا"},{"word":"Au revoir","translation":"إلى اللقاء"},{"word":"À plus","translation":"أراك لاحقًا"},{"word":"Ciao","translation":"وداعًا"},{"word":"un voisin / une voisine","translation":"جار / جارة"},{"word":"un copain / une copine","translation":"صديق / صديقة"},{"word":"un ami / une amie","translation":"صديق / صديقة"},{"word":"un camarade de classe","translation":"زميل دراسة"}],"grammar":{"title":"s'appeler et être","explanationAr":"نستخدم s'appeler لذكر الاسم، وêtre للتعريف بالشخص أو وصفه.","examples":[{"fr":"Je m'appelle Mathilde.","ar":"اسمي ماتيلد."},{"fr":"Je suis élève.","ar":"أنا تلميذ/تلميذة."},{"fr":"C'est Théo.","ar":"هذا تيو."}]},"communication":["Saluer","Se présenter","Demander le nom","Dire l'âge","Dire sa ville","Présenter une autre personne"],"conversation":{"note":"محادثة قصيرة للتدرب على التحية والتعارف، مبنية على موقف الوحدة دون نسخ النص الكامل للمصدر.","lines":[{"speaker":"A","fr":"Bonjour ! Je m'appelle Sara.","ar":"مرحبًا! اسمي سارة."},{"speaker":"B","fr":"Salut ! Moi, c'est Adam.","ar":"أهلًا! أنا آدم."},{"speaker":"A","fr":"Tu as quel âge ?","ar":"كم عمرك؟"},{"speaker":"B","fr":"J'ai quinze ans.","ar":"عمري خمسة عشر عامًا."}]},"practice":[{"question":"اختر التحية المناسبة في بداية اللقاء.","options":["Bonjour","Au revoir","Ciao"],"answer":0},{"question":"أكمل: Je ___ appelle Sara.","options":["m'","me","mon"],"answer":0},{"question":"كيف تقول: عمري 15 سنة؟","options":["Je suis quinze ans.","J'ai quinze ans.","Je m'appelle quinze ans."],"answer":1}],"journey":["البداية","المفردات","النطق","القواعد","المحادثة","التدريب","الفيديو","الألعاب","المراجعة الذكية","التقييم","التقدم"]}