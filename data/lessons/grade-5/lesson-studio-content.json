{
  "curriculum":"Le français pour vous",
  "level":"5e année",
  "lessons":{
    "g5-t1-l01":{
      "titleFr":"La phrase simple","titleAr":"الجملة البسيطة","type":"Grammaire","duration":"20–25 min",
      "objectiveAr":"أن يفهم الطالب كيف تتكوّن الجملة الفرنسية البسيطة، وأن يميّز الفاعل والفعل والمفعول به، ثم يبني جملة صحيحة بنفسه.",
      "objectiveFr":"Comprendre la structure de la phrase simple et identifier le sujet, le verbe et le complément.",
      "video":{"title":"La phrase simple : sujet, verbe et complément","descriptionAr":"فيديو تمهيدي يشرح الفكرة الأساسية للدرس بصريًا. إذا لم يتوفر ملف فيديو محلي، تظهر بطاقة الفيديو مع خيار فتح المصدر الخارجي.","youtube":"https://www.youtube.com/results?search_query=La+phrase+sujet+verbe+compl%C3%A9ment+fran%C3%A7ais"},
      "grammar":{"titleAr":"كيف نبني جملة فرنسية بسيطة؟","titleFr":"Construire une phrase simple","explanationAr":"الجملة الفرنسية البسيطة تتكوّن في هذا الدرس من ثلاثة أجزاء أساسية: الفاعل، ثم الفعل، ثم المفعول به أو المتمّم. تخيّلها مثل قطار صغير: كل عربة لها وظيفة محددة، وعند ترتيبها بشكل صحيح نحصل على جملة مفهومة.","steps":["1. Sujet — الفاعل: من يقوم بالفعل؟ قد يكون اسمًا أو ضميرًا شخصيًا.","2. Verbe — الفعل: ما الفعل أو الحدث الذي يقوم به الفاعل؟","3. Complément — المفعول به/المتمّم: ما الذي يتعلّق به الفعل أو ما المعلومات التي تكمل المعنى؟"],"examples":[{"fr":"Mona parle français.","ar":"مونا تتحدث الفرنسية.","parts":["Mona","parle","français"]},{"fr":"Je parle anglais.","ar":"أنا أتحدث الإنجليزية.","parts":["Je","parle","anglais"]},{"fr":"Ali aime le français.","ar":"علي يحب اللغة الفرنسية.","parts":["Ali","aime","le français"]}],"miniRule":"Sujet + Verbe + Complément"},
      "vocabulary":[
        {"word":"une phrase","meaning":"جملة","example":"Une phrase simple a trois parties."},
        {"word":"le sujet","meaning":"الفاعل","example":"Mona est le sujet."},
        {"word":"le verbe","meaning":"الفعل","example":"Parle est le verbe."},
        {"word":"le complément","meaning":"المفعول به / المتمّم","example":"Français est le complément."},
        {"word":"parler","meaning":"يتحدث","example":"Mona parle français."},
        {"word":"aimer","meaning":"يحب","example":"Ali aime le français."}
      ],
      "pronunciation":["une phrase","le sujet","le verbe","le complément","Mona parle français.","Je parle anglais.","Ali aime le français."],
      "practice":[{"q":"في الجملة «Mona parle français.» ما الفاعل؟","options":["Mona","parle","français"],"answer":"Mona"},{"q":"في الجملة «Mona parle français.» ما الفعل؟","options":["Mona","parle","français"],"answer":"parle"},{"q":"ما ترتيب الجملة البسيطة في هذا الدرس؟","options":["Verbe + Sujet + Complément","Sujet + Verbe + Complément","Complément + Sujet + Verbe"],"answer":"Sujet + Verbe + Complément"}],
      "extensionAr":"إضافة تعليمية: بعد فهم النموذج، اطلب من الطالب تكوين ثلاث جمل من حياته اليومية، مثل: Je parle français. / J'aime le français. / Mona parle anglais."
    },
    "g5-t1-l02":{"titleFr":"Les déterminants","titleAr":"أدوات التعريف والتنكير","type":"Grammaire","duration":"20 min","objectiveAr":"تمييز أدوات التنكير والتعريف واختيار الأداة المناسبة حسب الجنس والعدد.","grammar":{"titleAr":"أدوات التعريف والتنكير","titleFr":"Les articles définis et indéfinis","explanationAr":"يتعلم الطالب أن الاسم الفرنسي يسبقه محدد يوضح إن كان مذكرًا أو مؤنثًا، مفردًا أو جمعًا.","steps":["Un: مذكر مفرد — un stylo","Une: مؤنث مفرد — une gomme","Des: جمع — des stylos","Le / La / L’ / Les: أدوات التعريف حسب الجنس والعدد وبداية الكلمة."],"examples":[{"fr":"un stylo","ar":"قلم جاف"},{"fr":"une gomme","ar":"استيكة"},{"fr":"des stylos","ar":"أقلام"},{"fr":"l'animal","ar":"الحيوان"},{"fr":"les stylos","ar":"الأقلام"}]},"vocabulary":[{"word":"un stylo","meaning":"قلم جاف"},{"word":"une gomme","meaning":"استيكة"},{"word":"l'animal","meaning":"الحيوان"},{"word":"les stylos","meaning":"الأقلام"}],"pronunciation":["un stylo","une gomme","des stylos","l'animal","les stylos"],"practice":[{"q":"اختر الأداة الصحيحة: ___ stylo","options":["un","une","des"],"answer":"un"},{"q":"اختر الأداة الصحيحة: ___ gomme","options":["un","une","des"],"answer":"une"}]},
    "g5-t1-l03":{"titleFr":"Le pluriel","titleAr":"صيغة الجمع","type":"Grammaire","duration":"20 min","objectiveAr":"تكوين جمع الأسماء والتعرف على أهم القواعد والاستثناءات الواردة في الدرس.","grammar":{"titleAr":"قواعد الجمع","titleFr":"Les règles du pluriel","explanationAr":"القاعدة العامة هي إضافة S إلى الاسم وتغيير الأداة، مع وجود حالات خاصة مثل eau/au و s/x/z و al.","steps":["القاعدة العامة: un livre → des livres","الكلمات المنتهية بـ eau أو au تأخذ X: un tableau → des tableaux","الكلمات المنتهية بـ S أو X أو Z لا تتغير كتابتها غالبًا: un pays → des pays","الكلمات المنتهية بـ AL تتحول في أمثلة الدرس إلى AUX: un animal → des animaux"],"examples":[{"fr":"un livre → des livres","ar":"كتاب → كتب"},{"fr":"un tableau → des tableaux","ar":"سبورة → سبورات"},{"fr":"un pays → des pays","ar":"بلد → بلاد"},{"fr":"un animal → des animaux","ar":"حيوان → حيوانات"}]},"vocabulary":[{"word":"un livre","meaning":"كتاب"},{"word":"un tableau","meaning":"سبورة"},{"word":"un animal","meaning":"حيوان"},{"word":"un pays","meaning":"بلد"},{"word":"un cheval","meaning":"حصان"}],"pronunciation":["un livre","des livres","un tableau","des tableaux","un animal","des animaux"],"practice":[{"q":"جمع un livre هو:","options":["des livres","des livre","les livre"],"answer":"des livres"},{"q":"جمع un animal هو:","options":["des animals","des animaux","les animal"],"answer":"des animaux"}]},
    "g5-t1-l04":{"titleFr":"Les nombres","titleAr":"الأرقام","type":"Vocabulaire","duration":"20 min","objectiveAr":"قراءة الأعداد الفرنسية وتكوين الأعداد المركبة وفهم الصيغ الخاصة 70 و80 و90.","grammar":{"titleAr":"كيف نكوّن الأعداد؟","titleFr":"Former les nombres","explanationAr":"نتدرّج من 0 إلى 20، ثم نتعرف على العشرات، ثم نكوّن الأعداد المركبة. 70 و80 و90 لها صيغ خاصة يجب حفظها.","steps":["20 = vingt، 30 = trente، 40 = quarante، 50 = cinquante، 60 = soixante","70 = soixante-dix","80 = quatre-vingts","90 = quatre-vingt-dix","نستخدم et في بعض الأعداد المركبة مثل 21 و31 و41 و51 و61 و71."],"examples":[{"fr":"vingt et un","ar":"21"},{"fr":"soixante-dix","ar":"70"},{"fr":"quatre-vingts","ar":"80"},{"fr":"quatre-vingt-dix","ar":"90"}]},"vocabulary":[{"word":"vingt","meaning":"20"},{"word":"trente","meaning":"30"},{"word":"quarante","meaning":"40"},{"word":"cinquante","meaning":"50"},{"word":"soixante","meaning":"60"},{"word":"soixante-dix","meaning":"70"},{"word":"quatre-vingts","meaning":"80"},{"word":"quatre-vingt-dix","meaning":"90"}],"pronunciation":["vingt","trente","quarante","cinquante","soixante","soixante-dix","quatre-vingts","quatre-vingt-dix"],"practice":[{"q":"70 بالفرنسية:","options":["soixante-dix","quatre-vingts","quatre-vingt-dix"],"answer":"soixante-dix"},{"q":"80 بالفرنسية:","options":["quatre-vingts","soixante-dix","quatre-vingt-dix"],"answer":"quatre-vingts"}]},
    "g5-t1-l05":{"titleFr":"L'heure","titleAr":"الساعة","type":"Vocabulaire","duration":"20 min","objectiveAr":"السؤال عن الوقت والإجابة عنه واستخدام et quart وet demie وmoins le quart.","grammar":{"titleAr":"كيف نقول الوقت؟","titleFr":"Dire l'heure","explanationAr":"للسؤال نقول Quelle heure est-il ? وللإجابة نبدأ بـ Il est… ثم نذكر الساعة والتعبير المناسب للدقائق.","steps":["Quelle heure est-il ? — كم الساعة؟","Il est trois heures. — الساعة الثالثة.","et quart = وربع، et demie = ونصف، moins le quart = إلا ربع.","Il est midi = الثانية عشرة ظهرًا، Il est minuit = الثانية عشرة منتصف الليل."],"examples":[{"fr":"Quelle heure est-il ?","ar":"كم الساعة؟"},{"fr":"Il est trois heures.","ar":"الساعة الثالثة."},{"fr":"Il est six heures et demie.","ar":"الساعة السادسة والنصف."},{"fr":"Il est huit heures moins le quart.","ar":"الساعة الثامنة إلا ربعًا."}]},"vocabulary":[{"word":"Quelle heure est-il ?","meaning":"كم الساعة؟"},{"word":"Il est trois heures.","meaning":"الساعة الثالثة"},{"word":"et quart","meaning":"وربع"},{"word":"et demie","meaning":"ونصف"},{"word":"moins le quart","meaning":"إلا ربع"},{"word":"midi","meaning":"الظهر"},{"word":"minuit","meaning":"منتصف الليل"}],"pronunciation":["Quelle heure est-il ?","Il est trois heures.","et quart","et demie","moins le quart","midi","minuit"],"practice":[{"q":"15 دقيقة تعني:","options":["et quart","et demie","moins le quart"],"answer":"et quart"},{"q":"7:00 بالفرنسية:","options":["Il est sept heures.","Il est midi.","Il est minuit."],"answer":"Il est sept heures."}]},
    "g5-t1-l06":{"titleFr":"Les quatre saisons","titleAr":"الفصول الأربعة","type":"Vocabulaire","duration":"20 min","objectiveAr":"التعرف على الفصول الأربعة واستخدام au وen معها في الأمثلة الأساسية.","grammar":{"titleAr":"Au / En مع الفصول","titleFr":"Au / En avec les saisons","explanationAr":"في أمثلة الدرس نستخدم au مع printemps، ونستخدم en مع été وautomne وhiver.","steps":["au printemps","en été","en automne","en hiver"],"examples":[{"fr":"au printemps","ar":"في الربيع"},{"fr":"en été","ar":"في الصيف"},{"fr":"en automne","ar":"في الخريف"},{"fr":"en hiver","ar":"في الشتاء"}]},"vocabulary":[{"word":"l'automne","meaning":"الخريف"},{"word":"l'hiver","meaning":"الشتاء"},{"word":"le printemps","meaning":"الربيع"},{"word":"l'été","meaning":"الصيف"},{"word":"Il fait chaud.","meaning":"الجو حار."}],"pronunciation":["l'automne","l'hiver","le printemps","l'été","au printemps","en été"],"practice":[{"q":"الفصل الذي يأتي بعد l’hiver هو:","options":["le printemps","l’automne","l’été"],"answer":"le printemps"},{"q":"نقول:","options":["au printemps","en printemps","au été"],"answer":"au printemps"}]},
    "g5-t1-l07":{"titleFr":"Les pronoms et le présent","titleAr":"الضمائر والفعل في المضارع","type":"Grammaire","duration":"25 min","objectiveAr":"استخدام الضمائر الشخصية وتصريف أفعال المجموعة الأولى في المضارع وفق نموذج aimer وparler.","grammar":{"titleAr":"الضمائر والمضارع","titleFr":"Les pronoms personnels et le présent","explanationAr":"الضمير يحل محل الاسم، وفي الدرس نتدرب على المضارع وخاصة أفعال -ER مثل aimer وparler.","steps":["Je — أنا، Tu — أنت، Il/Elle — هو/هي، Nous — نحن، Vous — أنتم/حضرتك، Ils/Elles — هم/هن","نموذج parler: je parle, tu parles, il/elle parle, nous parlons, vous parlez, ils/elles parlent.","نستخدم الضمير المناسب بدل الاسم: Sara → Elle."],"examples":[{"fr":"Sara → Elle","ar":"سارة → هي"},{"fr":"Nous parlons trois langues.","ar":"نحن نتحدث ثلاث لغات."},{"fr":"J'aime le français.","ar":"أنا أحب الفرنسية."}]},"vocabulary":[{"word":"je","meaning":"أنا"},{"word":"tu","meaning":"أنت"},{"word":"il","meaning":"هو"},{"word":"elle","meaning":"هي"},{"word":"nous","meaning":"نحن"},{"word":"vous","meaning":"أنتم / حضرتك"},{"word":"ils","meaning":"هم"},{"word":"elles","meaning":"هن"}],"pronunciation":["je","tu","il","elle","nous","vous","ils","elles","Nous parlons trois langues."],"practice":[{"q":"Sara يمكن استبدالها بـ:","options":["Elle","Nous","Ils"],"answer":"Elle"},{"q":"Nous (parler) trois langues:","options":["parlons","parle","parlez"],"answer":"parlons"}]},
    "g5-t1-l08":{"titleFr":"Les adjectifs possessifs","titleAr":"الصفات الملكية","type":"Grammaire","duration":"20 min","objectiveAr":"اختيار الصفة الملكية المناسبة وفق جنس الاسم وعدده والتعرف على قاعدة الاسم المؤنث الذي يبدأ بحرف متحرك أو H.","grammar":{"titleAr":"الصفات الملكية","titleFr":"Les adjectifs possessifs","explanationAr":"الصفة الملكية تتغير حسب جنس وعدد الاسم الذي بعدها. وفي المفرد المؤنث الذي يبدأ بحرف متحرك أو H نستخدم mon/ton/son بدل ma/ta/sa في أمثلة الدرس.","steps":["مفرد مذكر: mon / ton / son","مفرد مؤنث: ma / ta / sa","جمع: mes / tes / ses","قاعدة خاصة: mon amie بدل ma amie."],"examples":[{"fr":"C'est mon livre.","ar":"هذا كتابي."},{"fr":"Ce sont mes oreilles.","ar":"هذه أذناي."},{"fr":"mon amie","ar":"صديقتي"}]},"vocabulary":[{"word":"mon","meaning":"ـي للمذكر"},{"word":"ma","meaning":"ـي للمؤنث"},{"word":"mes","meaning":"ـي للجمع"},{"word":"ton","meaning":"ـك للمذكر"},{"word":"son","meaning":"ـه/ـها للمفرد المذكر"},{"word":"amie","meaning":"صديقة"}],"pronunciation":["mon livre","ma maison","mes oreilles","mon amie"],"practice":[{"q":"J'ai des oreilles → Ce sont ___ oreilles.","options":["mes","ma","mon"],"answer":"mes"},{"q":"C'est ___ livre.","options":["mon","ma","mes"],"answer":"mon"}]},
    "g5-t1-l09":{"titleFr":"Le visage","titleAr":"الوجه","type":"Vocabulaire","duration":"20 min","objectiveAr":"تسمية أجزاء الوجه الأساسية بالفرنسية واستخدامها في جمل بسيطة.","grammar":{"titleAr":"التعبير عن أجزاء الوجه","titleFr":"Les parties du visage","explanationAr":"نتعلم أسماء أجزاء الوجه ونستخدمها في عبارات بسيطة للتعرف على الجزء ووصفه.","steps":["le nez — الأنف","la bouche — الفم","le front — الجبهة","l'oreille — الأذن","les yeux — العينان","les dents — الأسنان"],"examples":[{"fr":"le nez","ar":"الأنف"},{"fr":"la bouche","ar":"الفم"},{"fr":"l'oreille","ar":"الأذن"},{"fr":"les yeux","ar":"العينان"}]},"vocabulary":[{"word":"le nez","meaning":"الأنف"},{"word":"la bouche","meaning":"الفم"},{"word":"le front","meaning":"الجبهة"},{"word":"l'oreille","meaning":"الأذن"},{"word":"les yeux","meaning":"العينان"},{"word":"les dents","meaning":"الأسنان"}],"pronunciation":["le nez","la bouche","le front","l'oreille","les yeux","les dents"],"practice":[{"q":"الأنف بالفرنسية:","options":["le nez","la bouche","le front"],"answer":"le nez"},{"q":"الأذن بالفرنسية:","options":["l’oreille","les yeux","les dents"],"answer":"l’oreille"}]},
    "g5-t1-l10":{"titleFr":"Fournitures scolaires et fruits","titleAr":"اللوازم المدرسية والفواكه","type":"Vocabulaire","duration":"20 min","objectiveAr":"التعرف على مفردات اللوازم المدرسية والفواكه واستخدامها في جمل بسيطة.","grammar":{"titleAr":"مفردات من الحياة اليومية","titleFr":"Les fournitures et les fruits","explanationAr":"نربط المفردات بصور وأمثلة قصيرة لتسهيل التذكر والاستعمال.","steps":["un stylo — قلم جاف","une trousse — مقلمة","une pomme — تفاحة","une banane — موزة"],"examples":[{"fr":"un stylo","ar":"قلم جاف"},{"fr":"une trousse","ar":"مقلمة"},{"fr":"une pomme","ar":"تفاحة"},{"fr":"une banane","ar":"موزة"}]},"vocabulary":[{"word":"un stylo","meaning":"قلم جاف"},{"word":"une trousse","meaning":"مقلمة"},{"word":"une pomme","meaning":"تفاحة"},{"word":"une banane","meaning":"موزة"}],"pronunciation":["un stylo","une trousse","une pomme","une banane"],"practice":[{"q":"___ banane","options":["une","un","des"],"answer":"une"},{"q":"قلم بالفرنسية:","options":["un stylo","une trousse","une pomme"],"answer":"un stylo"}]},
    "g5-t1-l11":{"titleFr":"Le corps","titleAr":"الجسم","type":"Vocabulaire","duration":"20 min","objectiveAr":"التعرف على أجزاء الجسم الأساسية بالفرنسية ونطقها واستخدامها في تدريبات قصيرة.","grammar":{"titleAr":"أجزاء الجسم","titleFr":"Les parties du corps","explanationAr":"نستكشف أجزاء الجسم الأساسية، ثم ننتقل إلى النطق والتدريب والتقييم.","steps":["le pied — القدم","le bras — الذراع","la main — اليد","la jambe — الساق","le genou — الركبة"],"examples":[{"fr":"le pied","ar":"القدم"},{"fr":"le bras","ar":"الذراع"},{"fr":"la main","ar":"اليد"},{"fr":"la jambe","ar":"الساق"},{"fr":"le genou","ar":"الركبة"}]},"vocabulary":[{"word":"le pied","meaning":"القدم"},{"word":"le bras","meaning":"الذراع"},{"word":"la main","meaning":"اليد"},{"word":"la jambe","meaning":"الساق"},{"word":"le genou","meaning":"الركبة"}],"pronunciation":["le pied","le bras","la main","la jambe","le genou"],"practice":[{"q":"القدم بالفرنسية:","options":["le pied","la main","le coude"],"answer":"le pied"},{"q":"الذراع:","options":["le bras","la jambe","le genou"],"answer":"le bras"}]}
  }
}