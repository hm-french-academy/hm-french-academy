    {"id":"R10","domain":"clothing_description","microReview":"Clothes, porter and colour agreement","items":["Name five clothes.","Je ___ un T-shirt bleu. (porter)","Write: une robe + rouge correctly.","Write one winter clothing sentence."],"masteryRule":"4/4"},
    {"id":"R11","domain":"question_functions","microReview":"Question toolkit","items":["Ask the name with Comment.","Ask nationality.","Ask the person with Qui.","Ask about an object with Qu'est-ce que c'est ?"],"masteryRule":"4 functional questions"},
