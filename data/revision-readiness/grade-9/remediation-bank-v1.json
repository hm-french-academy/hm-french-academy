  "clusters":[
    {"id":"R01","domain":"identity_communication","microReview":"Greetings, name and basic introduction","items":["Choose: Je m'appelle / Je t'appelle Karim.","Complete: Comment ___ t'appelles ?","Write one greeting and one leave-taking expression."],"masteryRule":"3/3 or teacher-approved equivalent"},
    {"id":"R02","domain":"phonology","microReview":"Alphabet and vowels","items":["Write a, e, i, o, u.","Circle the vowel in: livre.","Read aloud: radio, cinéma, téléphone."],"masteryRule":"accurate recognition + intelligible reading"},
    {"id":"R03","domain":"numbers_time","microReview":"Numbers 0–20 and time","items":["Write 7, 13 and 20 in French.","Answer: Quel âge as-tu ?","Answer: Quelle heure est-il ? — 8:00"],"masteryRule":"3/3"},
    {"id":"R04","domain":"grammar_core","microReview":"Être, avoir, s'appeler","items":["Je ___ égyptien. (être)","J'___ 12 ans. (avoir)","Elle ___ Lina. (s'appeler)"],"masteryRule":"3/3"},
    {"id":"R05","domain":"grammar_core","microReview":"Articles and gender","items":["___ livre (un/une)","___ trousse (un/une)","___ parents (le/la/les)","Change: un stylo bleu → une robe ___."],"masteryRule":"4/4"},
    {"id":"R06","domain":"classroom","microReview":"Classroom objects and identification","items":["Name four classroom objects.","Answer: Qu'est-ce que c'est ? — ___ cahier.","Sort: livre / sœur / règle into classroom vs family."],"masteryRule":"accurate vocabulary + article"},
    {"id":"R07","domain":"colours_calendar","microReview":"Colours, days, months and seasons","items":["Write six colours.","Write seven days.","Write four seasons.","Complete: en ______ (season)."],"masteryRule":"80%+ recall"},
