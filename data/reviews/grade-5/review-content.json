  "diagnostic":{"minutes":20,"purpose":"قياس نقطة البداية فقط؛ لا يعيد أسئلة التدريب","questions":[
    {"id":"D01","q":"Quel mot est un vêtement ?","options":["Une veste","Un nez","Une saison"],"answer":0,"lesson":"l1","explanation":"«Une veste» اسم قطعة ملابس، لذلك هي الإجابة التي تنتمي إلى مفردات درس الملابس؛ أما «un nez» فهو جزء من الجسم و«une saison» فصل من السنة."},
    {"id":"D02","q":"J'___ une robe.","options":["ai","as","a"],"answer":0,"lesson":"l1","explanation":"الفاعل «Je» مع الفعل avoir يأخذ التصريف «ai». لذلك نقول «J'ai une robe»."},
    {"id":"D03","q":"La chemise est ___.","options":["bleue","bleu","bleues"],"answer":0,"lesson":"l2","explanation":"«La chemise» مؤنث مفرد، واللون «bleu» صفة تتوافق مع الاسم؛ لذلك تصبح في المؤنث المفرد «bleue»."},
    {"id":"D04","q":"Nous ___ grands.","options":["sommes","êtes","sont"],"answer":0,"lesson":"l3","explanation":"الفاعل «Nous» مع الفعل être يأخذ التصريف «sommes». لذلك نقول «Nous sommes grands»."},
    {"id":"D05","q":"Elle est ___. (gros)","options":["gros","grosse","grosses"],"answer":1,"lesson":"l4","explanation":"«Elle» مؤنث مفرد، والصفة «gros» تتحول إلى المؤنث «grosse». لذلك الإجابة «grosse»."},
    {"id":"D06","q":"Mon père ___ long.","options":["est","es","sont"],"answer":0,"lesson":"l5","explanation":"«Mon père» مفرد غائب، ومع être نستخدم «est». لذلك نقول «Mon père est long»."},
    {"id":"D07","q":"Je n'ai pas ___ pull.","options":["un","de","des"],"answer":1,"lesson":"l6","explanation":"بعد نفي avoir بـ«ne...pas» تتحول أداة التنكير «un» إلى «de». لذلك نقول «Je n'ai pas de pull»."},
    {"id":"D08","q":"Elle ___ pas longue.","options":["n'est","ne est","n'a"],"answer":0,"lesson":"l6","explanation":"النفي مع être يحتاج «ne...pas»، وقبل حرف متحرك تختصر «ne» إلى «n'». لذلك نقول «Elle n'est pas longue»."}
  ]},
  "practiceQuestions":[
    {"id":"P01","q":"Tu portes ___ pantalon noir.","options":["un","une","des"],"answer":0,"lesson":"l1","explanation":"«pantalon» اسم مذكر مفرد، لذلك نستخدم أداة التنكير «un»: «un pantalon»."},
    {"id":"P02","q":"Nous ___ une veste et des chaussures.","options":["avons","avez","ont"],"answer":0,"lesson":"l1","explanation":"الفاعل «Nous» مع avoir يأخذ التصريف «avons». لذلك نقول «Nous avons»."},
    {"id":"P03","q":"Les chaussettes sont ___.","options":["blanche","blanches","blanc"],"answer":1,"lesson":"l2","explanation":"«Les chaussettes» مؤنث جمع، لذلك تتوافق الصفة «blanc» معها فتصبح «blanches»."},
    {"id":"P04","q":"Elle ___ petite.","options":["est","es","sont"],"answer":0,"lesson":"l3","explanation":"الفاعل «Elle» مع الفعل être يأخذ التصريف «est». لذلك نقول «Elle est petite»؛ أما «es» فتأتي مع «Tu» و«sont» مع الجمع."},
    {"id":"P05","q":"Il est ___. (vieux)","options":["vieux","vieille","vieilles"],"answer":0,"lesson":"l4","explanation":"الفاعل «Il» مذكر مفرد، لذلك نستخدم الصيغة المذكرة المفردة «vieux». صيغة «vieille» للمؤنث المفرد."},
    {"id":"P06","q":"Ils ___ pas de gants.","options":["n'ont","n'avons","n'avez"],"answer":0,"lesson":"l6","explanation":"الفاعل «Ils» مع avoir يأخذ «ont»، وفي النفي تصبح «n'ont ... pas». لذلك نقول «Ils n'ont pas de gants»."}
  ],
  "reviewActivities":[
    {"id":"a-l1","lessonId":"l1","title":"تدريب الملابس وavoir","questions":[{"q":"Elle ___ une robe.","options":["a","as","ai"],"answer":0,"explanation":"الفاعل «Elle» مع avoir يأخذ التصريف «a»، لذلك نقول «Elle a une robe»."},{"q":"___ chaussures.","options":["un","une","des"],"answer":2,"explanation":"«chaussures» اسم جمع، لذلك نستخدم أداة التنكير للجمع «des»: «des chaussures»."}]},
    {"id":"a-l2","lessonId":"l2","title":"تدريب الألوان","questions":[{"q":"La robe est ___.","options":["rouge","rouges","rougee"],"answer":0,"explanation":"«La robe» مؤنث مفرد، والصفة «rouge» لها نفس الصيغة في المذكر والمؤنث المفرد، لذلك «rouge» صحيحة."},{"q":"Les chaussures sont ___.","options":["noires","noir","noire"],"answer":0,"explanation":"«Les chaussures» مؤنث جمع، لذلك «noir» تصبح «noires» للمؤنث الجمع."}]},
    {"id":"a-l3","lessonId":"l3","title":"تدريب être","questions":[{"q":"Ils ___ longs.","options":["est","sont","êtes"],"answer":1,"explanation":"الفاعل «Ils» جمع، وتصريف être معه هو «sont». لذلك نقول «Ils sont longs»."},{"q":"Tu ___ petit.","options":["es","est","suis"],"answer":0,"explanation":"الفاعل «Tu» مع être يأخذ التصريف «es». لذلك نقول «Tu es petit»."}]},
    {"id":"a-l6","lessonId":"l6","title":"تدريب النفي","questions":[{"q":"Je suis grand → Je ___.","options":["ne suis pas grand","n'ai pas grand","ne est pas grand"],"answer":0,"explanation":"لنفي جملة مع être نضع «ne» قبل الفعل و«pas» بعده؛ ومع «Je suis» تصبح «Je ne suis pas grand»."},{"q":"Nous avons des gants → Nous n'avons pas ___ gants.","options":["des","de","du"],"answer":1,"explanation":"بعد نفي avoir تتحول أداة الجمع «des» إلى «de»، لذلك نقول «Nous n'avons pas de gants»."}]}
  ],
